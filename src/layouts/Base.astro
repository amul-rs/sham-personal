---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { person, profiles } from '../data/site.js';

const {
  title,
  description,
  /** Suppresses the name suffix on the home page. */
  bareTitle = false,
  /** Open Graph type. 'profile' belongs on /about only. */
  ogType = 'website',
  /** Utility pages should not be indexed. */
  noindex = false,
} = Astro.props;

const fullTitle = bareTitle ? title : `${title} — ${person.name}`;

// Search engines truncate around 160 characters. Fail loudly at build time
// rather than shipping a description that gets cut mid-sentence.
if (description && description.length > 160) {
  console.warn(
    `[seo] ${Astro.url.pathname} meta description is ${description.length} chars (max 160)`
  );
}
const canonical = new URL(Astro.url.pathname, Astro.site);
// Social platforms will not fetch a relative image, so this must be absolute.
const ogImage = new URL('/og.png', Astro.site);

/**
 * One Person entity, identical on every page.
 *
 * No postal address is emitted: none has been supplied for Eabenson Healthcare,
 * and the university department address stopped describing him when the MD
 * completed. An address we cannot stand behind is worse than none.
 *
 * `description` is deliberately NOT the page's meta description. It used to be,
 * which meant /privacy told crawlers that Dr Eabenson *is* "How this website
 * handles personal data", and /404 that he is "That page does not exist on this
 * site". A page description describes a page; a Person description describes a
 * person. The `@id` ties the 20 copies together as one entity.
 */
const orcid = profiles.find((p) => p.label === 'ORCID');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': new URL('#person', Astro.site).href,
  name: person.name,
  honorificSuffix: person.postNominals,
  jobTitle: person.title,
  description: person.lede,
  url: Astro.site?.href,
  email: person.email ? `mailto:${person.email}` : undefined,
  worksFor: { '@type': 'Organization', name: person.org },
  alumniOf: { '@type': 'CollegeOrUniversity', name: person.almaMater },
  identifier: orcid
    ? { '@type': 'PropertyValue', propertyID: 'ORCID', value: orcid.href }
    : undefined,
  sameAs: profiles.filter((p) => p.href).map((p) => p.href),
};
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Dr Shamin Eabenson, MBBS MD Community Medicine, above a row of tally marks"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#053A23" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Anek Latin carries a live width axis, used for display; Literata reads. -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anek+Latin:wdth,wght@75..100,300..700&family=Literata:ital,opsz,wght@0,7..72,400..600;1,7..72,400&display=swap"
    />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <!-- Controls in the Publications filter hide themselves when they cannot work. -->
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
