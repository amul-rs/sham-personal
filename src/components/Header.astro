---
import { nav, person } from '../data/site.js';
const path = Astro.url.pathname;
const isCurrent = (href) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="topbar">
  <div class="wrap bar">
    <a class="mark" href="/">Shamin Eabenson</a>

    <nav class="nav" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="nav-link"
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="actions">
      <a
        class="cv"
        href="/about/cv/"
        aria-current={path.startsWith('/about/cv') ? 'page' : undefined}
      >
        <span class="cv-long">Curriculum vitae</span>
        <span class="cv-short" aria-hidden="true">CV</span>
      </a>
      <button class="burger" id="burger" aria-expanded="false" aria-controls="mobile-nav">
        Menu
      </button>
    </div>
  </div>
</header>

<div class="sheet" id="mobile-nav" role="dialog" aria-modal="true" aria-label="Site menu" hidden>
  <nav class="sheet-nav" aria-label="Primary, mobile">
    {
      nav.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
  </nav>
  <p class="sheet-foot">{person.postNominals}</p>
</div>

<style>
  /* The masthead is a deep field of colour, continuous with the hero below it
     on the home page and a firm band everywhere else. */
  .topbar {
    position: sticky;
    top: 0;
    z-index: 60;
    background: var(--field-deep);
    color: var(--on-dark);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5);
    height: var(--header-h);
  }

  .mark {
    font-variation-settings: 'wdth' 80;
    font-weight: 700;
    font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.3rem);
    letter-spacing: -0.015em;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav {
    display: flex;
    gap: clamp(0.9rem, 0.2rem + 1.7vw, 2rem);
  }
  .nav-link {
    position: relative;
    font-size: var(--t-sm);
    color: var(--on-dark-soft);
    text-decoration: none;
    padding-block: 6px;
    transition: color var(--dur-fast) var(--ease);
  }
  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--on-dark);
  }
  .nav-link[aria-current='page'] {
    color: var(--on-dark);
  }
  .nav-link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--on-dark);
  }

  /* The CV is the one action that stays put. It sits outside the collapsible
     nav so it survives the mobile breakpoint, and is bordered rather than
     plain so it reads as an action and not a seventh nav link. */
  .actions {
    display: flex;
    align-items: center;
    gap: var(--s-4);
  }
  .cv {
    display: inline-block;
    font-size: var(--t-sm);
    line-height: 1;
    color: var(--on-dark);
    text-decoration: none;
    padding: 0.55em 0.9em;
    border: 1px solid var(--on-dark-soft);
    white-space: nowrap;
    transition:
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease);
  }
  .cv:hover,
  .cv:focus-visible {
    background: var(--on-dark);
    border-color: var(--on-dark);
    color: var(--field-deep);
  }
  .cv[aria-current='page'] {
    background: var(--on-dark);
    border-color: var(--on-dark);
    color: var(--field-deep);
  }
  /* On /about/cv the button is already filled, so currentColor is the same
     --field-deep as the masthead behind it: a 1.00:1 ring, i.e. none at all. */
  .cv[aria-current='page']:focus-visible {
    outline-color: var(--on-dark);
  }
  .cv-short {
    display: none;
  }
  /* Below the nav breakpoint the label shortens so the wordmark, the CV and
     Menu all still fit on a 320px screen. */
  @media (max-width: 560px) {
    .cv-long {
      display: none;
    }
    .cv-short {
      display: inline;
    }
  }

  .burger {
    display: none;
    font-size: var(--t-sm);
    color: var(--on-dark);
    padding: var(--s-2) 0;
  }
  /* 52.5em, not 840px: under text-only zoom (or a large default font) the
     viewport is unchanged, so a px query never fires and the seven-item nav
     stays up and overflows. An em query tracks the text instead. */
  @media (max-width: 52.5em) {
    .nav {
      display: none;
    }
    .burger {
      display: block;
    }
  }

  /* ---- mobile sheet ---- */
  .sheet {
    position: fixed;
    inset: var(--header-h) 0 0;
    z-index: 55;
    background: var(--field-deep);
    color: var(--on-dark);
    padding: var(--s-7) var(--gutter) var(--s-6);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow-y: auto;
  }
  .sheet[hidden] {
    display: none;
  }
  .sheet-nav {
    display: flex;
    flex-direction: column;
  }
  .sheet-nav a {
    font-variation-settings: 'wdth' 85;
    font-weight: 600;
    font-size: clamp(1.8rem, 1.1rem + 4.6vw, 2.8rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-decoration: none;
    padding-block: var(--s-4);
    border-bottom: 1px solid rgba(236, 238, 244, 0.16);
  }
  .sheet-nav a[aria-current='page'] {
    color: var(--marigold);
  }
  .sheet-foot {
    margin-top: var(--s-6);
    font-size: var(--t-sm);
    color: var(--on-dark-soft);
  }
</style>

<script>
  const burger = document.getElementById('burger');
  const sheet = document.getElementById('mobile-nav');

  function setOpen(open) {
    if (!burger || !sheet) return;
    burger.setAttribute('aria-expanded', String(open));
    sheet.hidden = !open;
    document.body.style.overflow = open ? 'hidden' : '';
    burger.textContent = open ? 'Close' : 'Menu';
    // The sheet covers the viewport. Without this, Tab walks straight off the
    // end of the menu and onto controls the user cannot see behind it.
    document.querySelectorAll('header.topbar ~ *, main, footer').forEach((el) => {
      if (el !== sheet) el.inert = open;
    });
  }

  burger?.addEventListener('click', () =>
    setOpen(burger.getAttribute('aria-expanded') !== 'true')
  );

  document.addEventListener('keydown', (e) => {
    if (burger?.getAttribute('aria-expanded') !== 'true') return;
    if (e.key === 'Escape') {
      setOpen(false);
      burger.focus();
      return;
    }
    if (e.key !== 'Tab') return;
    // Wrap focus between the burger and the last link in the sheet.
    const stops = [burger, ...sheet.querySelectorAll('a[href]')];
    const first = stops[0];
    const last = stops[stops.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  // Resizing past the breakpoint must not leave the page scroll-locked or
  // inert. Matches the CSS breakpoint, which is in em so it tracks text zoom.
  window
    .matchMedia('not all and (max-width: 52.5em)')
    .addEventListener('change', (e) => e.matches && setOpen(false));
</script>
