---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import PubRow from '../../components/PubRow.astro';
import { publications, fullCitation, bibtex } from '../../data/publications.js';
import { themes } from '../../data/themes.js';

// Grouped by year, newest first, no pagination — this many papers do not need it.
// Every count below is derived. Never write a number here that data can state.
const years = [...new Set(publications.map((p) => p.year))].sort((a, b) => b - a);
const themesWithPapers = themes.filter((t) => publications.some((p) => p.theme === t.slug));
const allBibtex = publications.map(bibtex).join('\n\n');
const yearSpan =
  years.length === 1 ? `all published in ${years[0]}` : `published ${years[years.length - 1]}–${years[0]}`;
---

<Base
  title="Publications"
  description={`${publications.length} peer-reviewed papers by Dr Shamin Eabenson across community medicine, medical education and public health.`}
>
  <PageHeader
    title="Publications"
    standfirst={`${publications.length} peer-reviewed papers, ${yearSpan}.`}
    count="Grouped by year, newest first. Each entry links to the DOI of record."
  />

  <section class="field-light pad">
    <div class="wrap">
      <!-- Enhancement only: with JS off every paper is already visible. -->
      <div class="filters">
        <div class="filter-row" role="group" aria-label="Filter publications by theme">
          <button class="chip is-on" data-filter="all" aria-pressed="true">
            All <span class="chip-n">{publications.length}</span>
          </button>
          {
            themesWithPapers.map((t) => (
              <button class="chip" data-filter={t.slug} aria-pressed="false">
                {t.short}
                <span class="chip-n">{publications.filter((p) => p.theme === t.slug).length}</span>
              </button>
            ))
          }
        </div>
        <button class="chip chip-export" data-copy={allBibtex}>Copy all BibTeX</button>
      </div>

      <p class="empty" id="empty" hidden>No papers under that theme.</p>

      {
        years.map((year) => (
          <section class="year-group" data-year={year}>
            <h2 class="year">{year}</h2>
            <div class="rows">
              {publications
                .filter((p) => p.year === year)
                .map((p) => (
                  <div class="row" data-theme={p.theme}>
                    <PubRow pub={p}>
                      <div class="actions">
                        <button class="btn" data-copy={fullCitation(p)}>
                          Copy citation
                        </button>
                        <button class="btn" data-copy={bibtex(p)}>
                          BibTeX
                        </button>
                      </div>
                    </PubRow>
                  </div>
                ))}
            </div>
          </section>
        ))
      }
    </div>
  </section>

</Base>

<script>
  // ---- theme filter ----
  const chips = document.querySelectorAll('[data-filter]');
  const rows = document.querySelectorAll('.row');
  const groups = document.querySelectorAll('.year-group');
  const empty = document.getElementById('empty');

  function apply(filter) {
    rows.forEach((row) => {
      row.hidden = filter !== 'all' && row.dataset.theme !== filter;
    });
    // A year heading with nothing under it is noise.
    groups.forEach((g) => {
      g.hidden = !g.querySelector('.row:not([hidden])');
    });
    if (empty) empty.hidden = !!document.querySelector('.row:not([hidden])');
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((c) => {
        const on = c === chip;
        c.classList.toggle('is-on', on);
        c.setAttribute('aria-pressed', String(on));
      });
      apply(chip.dataset.filter);
    });
  });

  // ---- copy buttons ----
  document.querySelectorAll('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const original = btn.textContent;
      try {
        await navigator.clipboard.writeText(btn.dataset.copy);
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Press Ctrl+C';
      }
      setTimeout(() => {
        btn.textContent = original;
      }, 2000);
    });
  });
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-4);
    padding-bottom: var(--s-6);
  }
  :global(html.no-js) .filters {
    display: none;
  }
  .filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  .chip {
    display: inline-flex;
    align-items: baseline;
    gap: var(--s-2);
    font-size: var(--t-sm);
    padding: var(--s-2) var(--s-4);
    border: 1px solid var(--rule);
    border-radius: var(--r-sm);
    color: var(--text-soft);
    transition:
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease),
      background-color var(--dur-fast) var(--ease);
  }
  .chip:hover {
    border-color: var(--field);
    color: var(--field);
  }
  .chip.is-on {
    background: var(--field);
    border-color: var(--field);
    color: var(--on-dark);
  }
  /* The selected chip is filled, so currentColor resolves to --on-dark and the
     global ring lands at 1.00:1 on the plaster page ground. */
  .chip.is-on:focus-visible {
    outline-color: var(--field-deep);
  }
  /* These are the per-theme paper counts — real data, not decoration. opacity
     dropped them to 2.78:1 on plaster and 3.53:1 on the filled chip. A solid
     token keeps them legible on both. */
  .chip-n {
    color: var(--text-mute);
  }
  .chip.is-on .chip-n {
    color: var(--on-dark);
  }
  .chip-export {
    margin-left: auto;
  }

  .empty {
    padding-block: var(--s-7);
    color: var(--text-mute);
    font-style: italic;
  }

  .year-group[hidden] {
    display: none;
  }
  .year {
    font-size: var(--t-sm);
    font-weight: 400;
    font-variation-settings: normal;
    letter-spacing: 0;
    color: var(--text-mute);
    padding-top: var(--s-5);
  }
  .row[hidden] {
    display: none;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-4);
  }
  :global(html.no-js) .actions {
    display: none;
  }
  .btn {
    font-size: var(--t-sm);
    padding: var(--s-2) var(--s-3);
    border: 1px solid var(--rule);
    border-radius: var(--r-sm);
    color: var(--text-soft);
    transition: border-color var(--dur-fast) var(--ease), color var(--dur-fast) var(--ease);
  }
  .btn:hover {
    border-color: var(--field);
    color: var(--field);
  }

  
  
  
  
</style>
