---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { decks, slideshare } from '../data/teaching.js';

// Individual deck URLs are not known, so every card points at the SlideShare
// profile rather than a guessed permalink. Swap `href` per deck once the
// links are supplied.
const journalClubs = decks.filter((d) => d.kind === 'Journal club');
const seminars = decks.filter((d) => d.kind === 'Seminar');
---

<Base
  title="Teaching"
  description="Journal club and seminar material from the Department of Community Medicine, BLDE (DU), Vijayapura, published openly for students and colleagues."
>
  <PageHeader
    title="Teaching"
    standfirst="Journal club and seminar material from the Department of Community Medicine, published openly. If it is useful to a student somewhere else, it should be available to them."
  />

  <section class="ground-sand pad">
    <div class="wrap">
      <div class="group">
        <h2 class="group-head">
          Journal club <span class="group-n">{journalClubs.length}</span>
        </h2>
        <ul class="decks">
          {
            journalClubs.map((d) => (
              <li>
                <a class="card deck" href={slideshare} rel="noopener">
                  <span class="deck-title">{d.title}</span>
                  <span class="deck-blurb">{d.blurb}</span>
                  {d.date && <span class="deck-date">{d.date}</span>}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="group">
        <h2 class="group-head">
          Seminar <span class="group-n">{seminars.length}</span>
        </h2>
        <ul class="decks">
          {
            seminars.map((d) => (
              <li>
                <a class="card deck" href={slideshare} rel="noopener">
                  <span class="deck-title">{d.title}</span>
                  <span class="deck-blurb">{d.blurb}</span>
                  {d.date && <span class="deck-date">{d.date}</span>}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <p class="all">
        <a class="link-fill" href={slideshare} rel="noopener">Browse everything on SlideShare</a>
      </p>

      <p class="host">
        Slides stay hosted on SlideShare. This site indexes them rather than duplicating them, so
        there is only ever one copy to keep current.
      </p>
    </div>
  </section>
</Base>

<style>
  .group + .group {
    margin-top: var(--s-8);
  }
  .group-head {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    font-size: var(--t-lg);
    font-variation-settings: 'wdth' 88;
    font-weight: 600;
    color: var(--text-mute);
    margin-bottom: var(--s-5);
  }
  .group-n {
    font-size: var(--t-sm);
    font-weight: 400;
  }

  .decks {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: var(--s-4);
  }
  .deck {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    height: 100%;
    padding: var(--s-5);
  }
  .deck-date {
    margin-top: auto;
    padding-top: var(--s-3);
    border-top: 1px solid var(--rule-soft);
  }
  .deck:hover .deck-title,
  .deck:focus-visible .deck-title {
    color: var(--field);
  }
  .deck-title {
    font-variation-settings: 'wdth' 90;
    font-weight: 600;
    font-size: var(--t-md);
    line-height: 1.2;
    letter-spacing: -0.015em;
  }
  .deck-blurb {
    font-family: var(--serif);
    font-size: var(--t-sm);
    line-height: 1.6;
    color: var(--text-soft);
  }
  .deck-date {
    font-size: var(--t-sm);
    color: var(--text-mute);
  }


  .all {
    margin-top: var(--s-8);
  }
  .host {
    margin-top: var(--s-6);
    font-size: var(--t-sm);
    color: var(--text-soft);
    max-width: 56ch;
  }
</style>
