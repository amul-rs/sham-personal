---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { person, elsewhereProfiles } from '../data/site.js';

const live = Boolean(person.formEndpoint);

const purposes = [
  'Research collaboration',
  'Consultation request',
  'Speaking invitation',
  'Student or teaching question',
  'Press and media',
];
---

<Base
  title="Contact"
  description="Contact Dr Shamin Eabenson about research collaboration, a telemedicine consultation, speaking invitations or student questions."
>
  <PageHeader
    title="Get in touch"
    standfirst="For research collaboration, a consultation, speaking invitations, questions from students, or press enquiries."
  />

  <section class="field-light pad">
    <div class="wrap form-grid">
      <div>
        {
          !live && person.email && (
            <div class="notice">
              <p>
                <strong>The form below is not connected yet.</strong> This site is static and has no
                mail server of its own, so a form service has to be configured before anything sent
                here can be delivered. In the meantime, email works:{' '}
                <a class="link" href={`mailto:${person.email}`}>
                  {person.email}
                </a>
              </p>
            </div>
          )
        }

        <form
          class="form"
          method="post"
          action={person.formEndpoint ?? undefined}
          aria-describedby={live ? undefined : 'form-disabled'}
        >
          <fieldset class="fs">
            <legend class="legend">What is this about?</legend>
            <div class="purposes">
              {
                purposes.map((p, i) => (
                  <label class="purpose">
                    <input type="radio" name="purpose" value={p} required={live} checked={i === 0} />
                    <span>{p}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <div class="field">
            <label for="name">Your name</label>
            <input id="name" name="name" type="text" autocomplete="name" required={live} />
          </div>

          <div class="field">
            <label for="email">Email address</label>
            <input id="email" name="email" type="email" autocomplete="email" required={live} />
          </div>

          <div class="field">
            <label for="org">Organisation <span class="opt">optional</span></label>
            <input id="org" name="organisation" type="text" autocomplete="organization" />
          </div>

          <div class="field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="7" required={live}></textarea>
          </div>

          <label class="consent">
            <input type="checkbox" name="consent" value="yes" required={live} />
            <span>
              I agree to my details being used to respond to this enquiry. See the
              <a class="link" href="/privacy/">privacy notice</a>.
            </span>
          </label>

          <p class="medical">
            Please do not describe your own symptoms or send medical records through this form, and
            do not use it for anything urgent. If you have a medical emergency, go to your nearest
            hospital. To arrange a telemedicine appointment, see
            <a class="link" href="/clinical/">consultation</a>.
          </p>

          <p>
            <button class="submit" type="submit" disabled={!live}>Send message</button>
            {
              !live && (
                <span id="form-disabled" class="disabled-why">
                  Sending is disabled until the form service is configured. Please use email.
                </span>
              )
            }
          </p>
        </form>
      </div>

      <aside class="aside">
        {
          person.email && (
            <>
              <h2 class="aside-h">Email</h2>
              <p class="mail">
                <a class="link" href={`mailto:${person.email}`}>
                  {person.email}
                </a>
              </p>
            </>
          )
        }

        <h2 class="aside-h aside-h-2">Elsewhere</h2>
        <ul class="links">
          {
            elsewhereProfiles.map((p) => (
              <li>
                <a class="link" href={p.href} rel="me noopener">
                  {p.label}
                </a>
              </li>
            ))
          }
        </ul>

        <h2 class="aside-h aside-h-2">Consultations</h2>
        <p class="note">
          Dr Eabenson consults by telemedicine.
          <a class="link" href="/clinical/">How it works</a>.
        </p>
      </aside>
    </div>
  </section>
</Base>

<style>
  .form-grid {
    display: grid;
    grid-template-columns: var(--split);
    gap: var(--split-gap);
    align-items: start;
  }
  @media (max-width: 880px) {
    .form-grid {
      grid-template-columns: 1fr;
      gap: var(--s-7);
    }
  }

  .notice {
    border-left: 3px solid var(--marigold-dark);
    background: var(--plaster-raised);
    padding: var(--s-4) var(--s-5);
    margin-bottom: var(--s-7);
    font-size: var(--t-sm);
    line-height: 1.7;
    color: var(--text-soft);
    max-width: 60ch;
    /* The email address is one long unbreakable token; without this it forces
       the whole page to scroll sideways on a 320px screen. */
    overflow-wrap: anywhere;
  }
  .notice strong {
    color: var(--text);
  }

  .form {
    display: grid;
    gap: var(--s-6);
    max-width: 48rem;
  }
  .fs {
    border: 0;
    padding: 0;
    margin: 0;
  }
  .legend {
    padding: 0;
    margin-bottom: var(--s-3);
    color: var(--text-mute);
    font-size: var(--t-sm);
  }
  .purposes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .purpose {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--rule);
    font-size: var(--t-sm);
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease);
  }
  .purpose:hover {
    border-color: var(--field);
  }
  /* The whole chip reads as selected, not just the radio dot. */
  .purpose:has(input:checked) {
    background: var(--field);
    border-color: var(--field);
    color: var(--on-dark);
  }
  .purpose:has(input:focus-visible) {
    outline: 3px solid currentColor;
    outline-offset: 2px;
  }

  .field {
    display: grid;
    gap: var(--s-2);
  }
  .field label {
    font-size: var(--t-sm);
    color: var(--text-mute);
  }
  .opt {
    color: var(--text-mute);
    font-style: italic;
  }
  input[type='text'],
  input[type='email'],
  textarea {
    width: 100%;
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--rule);
    background: var(--plaster-raised);
    color: var(--text);
    font-size: var(--t-base);
    transition: border-color var(--dur-fast) var(--ease);
  }
  input:focus,
  textarea:focus {
    border-color: var(--field);
  }
  textarea {
    resize: vertical;
    font-family: var(--serif);
    line-height: 1.6;
  }

  .consent {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-3);
    align-items: start;
    font-size: var(--t-sm);
    color: var(--text-soft);
    max-width: 56ch;
  }
  .consent input {
    margin-top: 0.3em;
  }

  .medical {
    font-size: var(--t-sm);
    line-height: 1.7;
    color: var(--text-soft);
    max-width: 56ch;
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule);
  }

  .submit {
    padding: var(--s-3) var(--s-6);
    border: 1px solid var(--field);
    background: var(--field);
    color: var(--on-dark);
    font-size: var(--t-base);
    transition: background-color var(--dur) var(--ease);
  }
  .submit:hover:not(:disabled) {
    background: var(--field-deep);
  }
  .submit:disabled {
    background: transparent;
    color: var(--text-mute);
    border-color: var(--rule);
    cursor: not-allowed;
  }
  .disabled-why {
    display: block;
    margin-top: var(--s-3);
    font-size: var(--t-sm);
    color: var(--text-mute);
  }

  .aside-h {
    font-size: var(--t-sm);
    color: var(--text-mute);
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--rule);
    margin-bottom: var(--s-4);
    font-weight: 400;
  }
  .aside-h-2 {
    margin-top: var(--s-7);
  }
  .mail {
    font-size: var(--t-sm);
    word-break: break-word;
  }
  .links {
    display: grid;
    gap: var(--s-3);
    font-size: var(--t-sm);
  }
  .note {
    font-size: var(--t-sm);
    line-height: 1.7;
    color: var(--text-soft);
  }
</style>
