---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { person, elsewhereProfiles } from '../data/site.js';

/**
 * A static site has no mail server. Rather than ship a form that silently
 * discards messages — or one that apologises for being switched off — the form
 * composes an email in the visitor's own mail client. It works everywhere, with
 * nothing to configure and nothing to pay for.
 *
 * If a form service is added later, set `person.formEndpoint` and the form
 * POSTs there instead, with no other change.
 */
const endpoint = person.formEndpoint;

const purposes = [
  'Research collaboration',
  'Consultation request',
  'Speaking invitation',
  'Student or teaching question',
  'Press and media',
];
---

<Base
  title="Contact"
  description="Contact Dr Shamin Eabenson about research collaboration, a telemedicine consultation, speaking invitations or student questions."
>
  <PageHeader
    title="Get in touch"
    standfirst="For research collaboration, a consultation, speaking invitations, questions from students, or press enquiries."
  />

  <section class="field-light pad">
    <div class="wrap form-grid">
      <div>
        <form
          class="form"
          id="enquiry"
          method={endpoint ? 'post' : undefined}
          action={endpoint ?? undefined}
          data-mailto={endpoint ? undefined : person.email}
        >
          <fieldset class="fs">
            <legend class="legend">What is this about?</legend>
            <div class="purposes">
              {
                purposes.map((p, i) => (
                  <label class="purpose">
                    <input type="radio" name="purpose" value={p} required checked={i === 0} />
                    <span>{p}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <div class="field">
            <label for="name">Your name</label>
            <input id="name" name="name" type="text" autocomplete="name" required />
          </div>

          <div class="field">
            <label for="email">Email address</label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>

          <div class="field">
            <label for="org">Organisation <span class="opt">optional</span></label>
            <input id="org" name="organisation" type="text" autocomplete="organization" />
          </div>

          <div class="field">
            <label for="message">Message</label>
            <textarea id="message" name="message" rows="7" required></textarea>
          </div>

          <label class="consent">
            <input type="checkbox" name="consent" value="yes" required />
            <span>
              I agree to my details being used to respond to this enquiry. See the
              <a class="link" href="/privacy/">privacy notice</a>.
            </span>
          </label>

          <p class="medical">
            Please do not describe your own symptoms or send medical records through this form, and
            do not use it for anything urgent. If you have a medical emergency, go to your nearest
            hospital. To arrange a telemedicine appointment, see
            <a class="link" href="/clinical/">consultation</a>.
          </p>

          <p class="send">
            <button class="submit" type="submit">Send message</button>
          </p>
        </form>
      </div>

      <aside class="aside">
        {
          person.email && (
            <>
              <h2 class="aside-h">Email directly</h2>
              <p class="mail">
                <a class="link" href={`mailto:${person.email}`}>
                  {person.email}
                </a>
              </p>
            </>
          )
        }

        <h2 class="aside-h aside-h-2">Elsewhere</h2>
        <ul class="links">
          {
            elsewhereProfiles.map((p) => (
              <li>
                <a class="link" href={p.href} rel="me noopener">
                  {p.label}
                </a>
              </li>
            ))
          }
        </ul>

        <h2 class="aside-h aside-h-2">Consultations</h2>
        <p class="note">
          Dr Eabenson consults by telemedicine.
          <a class="link" href="/clinical/">How it works</a>.
        </p>
      </aside>
    </div>
  </section>
</Base>

<script>
  // Compose the message in the visitor's mail client. Only runs when no form
  // service is configured; with one, the form POSTs normally.
  const form = document.getElementById('enquiry');
  const to = form?.dataset.mailto;
  if (form && to) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const f = new FormData(form);
      const purpose = f.get('purpose') || 'Enquiry';
      const org = f.get('organisation');
      const body = [
        f.get('message'),
        '',
        '—',
        `${f.get('name')}${org ? `, ${org}` : ''}`,
        f.get('email'),
      ].join('\n');
      window.location.href =
        `mailto:${to}?subject=${encodeURIComponent(purpose)}&body=${encodeURIComponent(body)}`;
    });
  }
</script>

<style>
  .form-grid {
    display: grid;
    grid-template-columns: var(--split);
    gap: var(--split-gap);
    align-items: start;
  }
  @media (max-width: 880px) {
    .form-grid {
      grid-template-columns: 1fr;
      gap: var(--s-7);
    }
  }

  .form {
    display: grid;
    gap: var(--s-6);
    max-width: 48rem;
  }
  .fs {
    border: 0;
    padding: 0;
    margin: 0;
  }
  .legend {
    padding: 0;
    margin-bottom: var(--s-3);
    color: var(--text-mute);
    font-size: var(--t-sm);
  }
  .purposes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .purpose {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--rule);
    border-radius: var(--r-sm);
    font-size: var(--t-sm);
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease);
  }
  .purpose:hover {
    border-color: var(--field);
  }
  /* The whole chip reads as selected, not just the radio dot. */
  .purpose:has(input:checked) {
    background: var(--field);
    border-color: var(--field);
    color: var(--on-dark);
  }
  .purpose:has(input:focus-visible) {
    outline: 3px solid currentColor;
    outline-offset: 2px;
  }

  .field {
    display: grid;
    gap: var(--s-2);
  }
  .field label {
    font-size: var(--t-sm);
    color: var(--text-mute);
  }
  .opt {
    color: var(--text-mute);
    font-style: italic;
  }
  input[type='text'],
  input[type='email'],
  textarea {
    width: 100%;
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--rule);
    border-radius: var(--r-sm);
    background: var(--plaster-raised);
    color: var(--text);
    font-size: var(--t-base);
    transition: border-color var(--dur-fast) var(--ease);
  }
  input:focus,
  textarea:focus {
    border-color: var(--field);
  }
  textarea {
    resize: vertical;
    font-family: var(--serif);
    line-height: 1.6;
  }

  .consent {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-3);
    align-items: start;
    font-size: var(--t-sm);
    color: var(--text-soft);
    max-width: 56ch;
  }
  .consent input {
    margin-top: 0.3em;
  }

  .medical {
    font-size: var(--t-sm);
    line-height: 1.7;
    color: var(--text-soft);
    max-width: 56ch;
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule);
  }

  .submit {
    padding: var(--s-3) var(--s-6);
    border: 1px solid var(--field);
    border-radius: var(--r-sm);
    background: var(--field);
    color: var(--on-dark);
    font-size: var(--t-base);
    transition: background-color var(--dur) var(--ease);
  }
  .submit:hover {
    background: var(--field-deep);
  }

  .aside-h {
    font-size: var(--t-sm);
    color: var(--text-mute);
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--rule);
    margin-bottom: var(--s-4);
    font-weight: 400;
  }
  .aside-h-2 {
    margin-top: var(--s-7);
  }
  .mail {
    font-size: var(--t-sm);
    overflow-wrap: anywhere;
  }
  .links {
    display: grid;
    gap: var(--s-3);
    font-size: var(--t-sm);
  }
  .note {
    font-size: var(--t-sm);
    line-height: 1.7;
    color: var(--text-soft);
  }
</style>
