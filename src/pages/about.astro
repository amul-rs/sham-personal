---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { person } from '../data/site.js';
import { publications } from '../data/publications.js';
import { themes } from '../data/themes.js';
import {
  education,
  registration,
  awards,
  visibleMemberships,
  medicalVentures,
} from '../data/credentials.js';

// Derived, never hardcoded, so the prose cannot drift from the data.
const journalCount = new Set(publications.map((p) => p.journal)).size;
const mbbs = education.find((e) => e.degree === 'MBBS');
const md = education.find((e) => e.degree.startsWith('MD'));
---

<Base
  title="About"
  description="Dr Shamin Eabenson, MBBS MD Community Medicine. Founder and Director of Eabenson Healthcare Private Limited, and a public health researcher."
>
  <PageHeader
    title="About"
    standfirst="A physician in community medicine, researching how health systems, education and everyday risk shape the lives of people in North Karnataka."
  />

  <section class="field-light pad">
    <div class="wrap bio-grid">
      <div class="prose bio">
        <p>
          Dr Shamin Eabenson took his MBBS at {mbbs.institution} in {mbbs.place} in {mbbs.year}, and
          his MD in Community Medicine at {md.institution} in {md.place} in {md.year}. He is the
          {person.title.toLowerCase()} of {person.org}.
        </p>
        <p>
          Community medicine asks a different question from most of clinical practice. Instead of
          what is wrong with this patient, it asks what is happening to this population, and why.
          That shift runs through all of his published work. When he studied road traffic accidents
          in Vijayapura, the question was not how to treat the injured but who was being injured,
          and what happened in the hour that followed. When he surveyed medical students about
          artificial intelligence, the question was whether the curriculum is preparing them for the
          practice they will actually enter.
        </p>
        <p>
          He has published {publications.length} peer-reviewed papers across {journalCount} journals,
          covering medical education, road safety and emergency response, access to generic medicines
          under the Janaushadhi scheme, infection control, biomedical waste, heat related illness,
          the work of ASHA community health workers, and the perception of medical negligence among
          undergraduates. The common thread is the training and conduct of doctors, and the systems
          that surround a patient, examined with the same methods he would apply to any other public
          health problem.
        </p>
        <p>
          Alongside research he teaches and presents in departmental journal clubs, publishes his
          teaching material openly, and consults patients by telemedicine.
        </p>
      </div>

      <dl class="facts">
        <div>
          <dt>Qualifications</dt>
          <dd>{person.postNominals}</dd>
        </div>
        <div>
          <dt>Current post</dt>
          <dd>{person.title}, {person.org}</dd>
        </div>
        <div>
          <dt>Registration</dt>
          <dd>{registration.council}, {registration.number}</dd>
        </div>
        <div>
          <dt>Published</dt>
          <dd>{publications.length} papers across {journalCount} journals</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ── Education ── -->
  <section class="field-light">
    <div class="wrap block-grid">
      <h2 class="block-h">Education</h2>
      <div>
        <ul class="entries">
          {
            education.map((e) => (
              <li>
                <span class="e-main">{e.degree}</span>
                <span class="e-sub">
                  {e.institution}, {e.place}
                </span>
                <span class="e-side">{e.year}</span>
              </li>
            ))
          }
        </ul>
        <p class="reg">
          Registered with the {registration.council} ({registration.abbr}), registration number
          {' '}{registration.number}.
        </p>
      </div>
    </div>
  </section>

  <!-- ── Positions ── -->
  <section class="field-light">
    <div class="wrap block-grid">
      <h2 class="block-h">Positions</h2>
      <ul class="entries">
        {
          medicalVentures.map((v) => (
            <li>
              <span class="e-main">{v.name}</span>
              {v.role && <span class="e-sub">{v.role}</span>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ── Memberships ── -->
  <section class="field-light">
    <div class="wrap block-grid">
      <h2 class="block-h">Professional memberships</h2>
      <ul class="entries">
        {
          visibleMemberships.map((m) => (
            <li>
              <span class="e-main">{m.body}</span>
              <span class="e-sub">
                {m.detail}
                {m.number && `, ${m.number}`}
              </span>
              {m.dates && <span class="e-side">{m.dates}</span>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ── Awards ── -->
  <section class="field-light">
    <div class="wrap block-grid">
      <h2 class="block-h">Awards and recognition</h2>
      <ul class="entries">
        {
          awards.map((a) => (
            <li>
              <span class="e-main">{a.title}</span>
              {a.issuer && <span class="e-sub">{a.issuer}</span>}
              {a.date && <span class="e-side">{a.date}</span>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ── Onward ── -->
  <section class="field-light">
    <div class="wrap">
      <h2 class="section-head">Where the work goes</h2>
    </div>
    <ul class="onward">
      {
        themes.map((t) => (
          <li>
            <a class="row" href={`/research/${t.slug}/`}>
              <span class="wrap row-inner">
                <span class="row-title">{t.title}</span>
                <span class="row-line">{t.card}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="field-strong pad">
    <div class="wrap split">
      <h2 class="cta-head">The full record, in one page.</h2>
      <div>
        <p><a class="link-fill" href="/about/cv/">Curriculum vitae</a></p>
        <p class="cta-body">
          Education, positions, memberships, awards and every publication — generated from the same
          data as this page, so the two cannot disagree.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .bio-grid,
  .block-grid,
  .split {
    display: grid;
    grid-template-columns: var(--split);
    gap: var(--split-gap);
    align-items: start;
  }
  @media (max-width: 880px) {
    .bio-grid,
    .block-grid,
    .split {
      grid-template-columns: 1fr;
      gap: var(--s-4);
    }
  }
  .bio {
    font-size: var(--t-md);
  }

  .facts {
    font-size: var(--t-sm);
  }
  .facts > div {
    padding-block: var(--s-4);
    border-top: 1px solid var(--rule);
  }
  .facts dt {
    color: var(--text-mute);
    margin-bottom: var(--s-1);
  }
  .facts dd {
    margin: 0;
  }

  /* ---- credential blocks ---- */
  .block-grid {
    padding-block: var(--s-7);
    border-top: 1px solid var(--rule);
  }
  .block-h {
    font-variation-settings: 'wdth' 88;
    font-weight: 600;
    font-size: var(--t-lg);
    letter-spacing: -0.02em;
    color: var(--text-mute);
  }

  .entries {
    display: grid;
  }
  .entries li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: var(--s-5);
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--rule);
  }
  .entries li:first-child {
    padding-top: 0;
  }
  .entries li:last-child {
    border-bottom: 0;
  }
  .e-main {
    font-variation-settings: 'wdth' 92;
    font-weight: 600;
    font-size: var(--t-base);
    letter-spacing: -0.01em;
  }
  .e-sub {
    grid-column: 1;
    font-family: var(--serif);
    font-size: var(--t-sm);
    line-height: 1.55;
    color: var(--text-soft);
    margin-top: var(--s-1);
    max-width: 58ch;
  }
  .e-side {
    grid-column: 2;
    grid-row: 1;
    font-size: var(--t-sm);
    color: var(--text-mute);
    white-space: nowrap;
  }
  @media (max-width: 520px) {
    .entries li {
      grid-template-columns: 1fr;
    }
    .e-side {
      grid-column: 1;
      grid-row: auto;
      margin-top: var(--s-2);
    }
  }

  .reg {
    margin-top: var(--s-5);
    font-size: var(--t-sm);
    color: var(--text-soft);
    max-width: 52ch;
  }

  /* ---- onward ---- */
  .section-head {
    font-size: var(--t-lg);
    font-variation-settings: 'wdth' 88;
    font-weight: 600;
    color: var(--text-mute);
    margin-block: var(--s-7) var(--s-6);
  }
  .onward {
    border-top: 1px solid var(--rule);
  }
  .onward li {
    border-bottom: 1px solid var(--rule);
  }
  .row {
    display: block;
    text-decoration: none;
    transition: background-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .row-inner {
    display: grid;
    grid-template-columns: var(--split);
    gap: var(--split-gap);
    align-items: baseline;
    padding-block: clamp(1rem, 0.7rem + 1.2vw, 1.75rem);
  }
  @media (max-width: 880px) {
    .row-inner {
      grid-template-columns: 1fr;
      gap: var(--s-3);
    }
  }
  .row-title {
    font-variation-settings: 'wdth' 88;
    font-weight: 600;
    font-size: var(--t-md);
    letter-spacing: -0.015em;
  }
  .row-line {
    font-family: var(--serif);
    font-size: var(--t-sm);
    line-height: 1.6;
    color: var(--text-soft);
  }
  .row:hover,
  .row:focus-visible {
    background: var(--field);
    color: var(--on-dark);
  }
  .row:hover .row-line,
  .row:focus-visible .row-line {
    color: var(--on-dark-soft);
  }

  .cta-head {
    font-variation-settings: 'wdth' 85;
    font-weight: 600;
    font-size: var(--t-xl);
    line-height: 1.1;
    letter-spacing: -0.025em;
    margin-left: var(--optical-left);
    color: var(--on-dark);
    max-width: 18ch;
  }
  .cta-body {
    margin-top: var(--s-5);
    font-family: var(--serif);
    font-size: var(--t-sm);
    line-height: 1.7;
    color: var(--on-dark-soft);
    max-width: 46ch;
  }
</style>
